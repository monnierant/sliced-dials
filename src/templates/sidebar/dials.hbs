<div class="sd-directory">
  {{#if isGM}}
  <div class="sd-directory-actions">
    <button type="button" data-action="create">
      <i class="fa-solid fa-plus"></i>
      {{localize "SLICEDDIALS.Sidebar.create"}}
    </button>
  </div>
  {{/if}}

  {{#if empty}}
  <p class="sd-directory-empty">{{localize "SLICEDDIALS.Sidebar.empty"}}</p>
  {{else}}
  <ol class="sd-directory-list">
    {{#each dials}}
    <li class="sd-directory-entry {{#if locked}}sd-locked{{/if}}">
      <button
        type="button"
        class="sd-directory-open"
        data-action="open"
        data-dial-id="{{id}}"
        {{#if anonymous}}disabled{{/if}}
      >
        {{{svg}}}
        <span class="sd-directory-name">{{name}}</span>
        <span class="sd-directory-count">{{count}}</span>
      </button>
    </li>
    {{/each}}
  </ol>
  {{/if}}
</div>
